{
  "name": "@leandroamariles/shoplab-contracts",
  "version": "1.5.0",
  "description": "Angular and TypeScript typed clients and models generated from ShopLab OpenAPI contracts.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate-all.mjs",
    "build": "npm run generate && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandroAmariles/shoplab-contracts.git"
  },
  "keywords": [
    "shoplab",
    "contracts",
    "openapi",
    "angular",
    "typescript"
  ],
  "author": "Leandro Amariles",
  "license": "MIT",
  "devDependencies": {
    "@angular/common": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@openapitools/openapi-generator-cli": "^2.16.2",
    "rxjs": "^7.8.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@angular/common": ">=18.0.0",
    "@angular/core": ">=18.0.0",
    "rxjs": "^7.8.0"
  }
}
